# ── SIGO Performance: Cache headers for static assets ──

# HTML pages: no cache (always fresh)
<FilesMatch "\.(html|htm|php)$">
    Header set Cache-Control "no-cache, must-revalidate"
</FilesMatch>

# CSS/JS with version params: immutable cache
<FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
</FilesMatch>

# Images: long cache
<FilesMatch "\.(ico|png|jpg|jpeg|gif|webp|avif|svg|woff|woff2|ttf|eot)$">
    Header set Cache-Control "public, max-age=604800, stale-while-revalidate=2592000"
</FilesMatch>

# Enable GZip compression for text assets
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Enable Brotli if available (15-20% smaller than gzip)
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Security headers
<IfModule mod_headers.c>
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
