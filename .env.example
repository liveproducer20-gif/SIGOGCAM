# Docker Compose
COMPOSE_PROJECT_NAME=SIGO - Sistema Inteligente de Gestión Operativa

# Puertos publicados en la computadora o VPS
FRONTEND_PORT=8080
BACKEND_PORT=3000
DB_PORT=1433

# SQL Server 2025 (17.x). El respaldo Backup/BITSAC2 fue creado en 17.x.
MSSQL_IMAGE=mcr.microsoft.com/mssql/server:2025-CU5-ubuntu-24.04
MSSQL_PID=Developer
MSSQL_SA_PASSWORD=CAMBIAR_POR_UNA_CLAVE_COMPLEJA
DB_DATABASE=BITSAC
DB_BACKUP_FILE=BITSAC2

# Backend
JWT_SECRET=CAMBIAR_POR_UN_SECRETO_ALEATORIO_DE_32_BYTES_O_MAS
JSON_LIMIT=25mb
DB_CONNECTION_TIMEOUT=30

# Flutter Web se publica detrás de Nginx. Mantener /api para mismo origen.
SIGO_API_BASE_URL=/api
